<?xml version="1.0" encoding="UTF-8"?>
<!--
  Utility Bills Manager - WiX v4 MSI installer
  =============================================
  CI build:
    wix build product.wxs AppFiles.wxs -d Version=x.y.z -b SourceDir=<abs-Release-path> \
      -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext -out app.msi

  Install WiX:
    dotnet tool install -g wix
    wix extension add WixToolset.UI.wixext WixToolset.Util.wixext -g

  Upgrade behaviour
  =================
  MajorUpgrade removes the old MSI before installing the new one.
  User data in %APPDATA%\AsanteDevs\Utility Bills Manager\ is NOT touched
  during an upgrade — it belongs to the user profile, not the MSI.

  Uninstall behaviour
  ===================
  Standard uninstall removes only the files that were installed.
  User data is preserved by default.
  To also remove user data, run:
    msiexec /x <product-code> REMOVE_USERDATA=1

  UpgradeCode MUST remain constant across all releases — never change it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Utility Bills Manager"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="AsanteDevs"
           UpgradeCode="8B4F7E2A-1C3D-4E5F-9ABC-DEF012345678"
           Scope="perMachine">

    <!--
      Upgrade: remove the old version automatically.
      Schedule="afterInstallInitialize" means the old MSI is uninstalled
      before the new files are laid down, preserving a clean upgrade.
      Downgrade is blocked with an error message.
    -->
    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Please uninstall it first." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Feature-tree UI: shows checkboxes for each feature including shortcuts -->
    <ui:WixUI Id="WixUI_FeatureTree" />

    <!-- Close the app if it is running before the upgrade proceeds -->
    <util:CloseApplication
      Id="CloseApp"
      Target="utility_bills_manager.exe"
      RebootPrompt="no"
      ElevatedCloseMessage="no" />

    <!-- Install location -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Utility Bills Manager" />
    </StandardDirectory>

    <!-- Shortcut target directories -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="Utility Bills Manager" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />

    <!-- Start Menu shortcut component -->
    <Component Id="StartMenuShortcut" Directory="AppMenuFolder" Guid="*">
      <Shortcut Id="StartMenuShortcutEntry"
                Name="Utility Bills Manager"
                Description="Manage your utility bills"
                Target="[INSTALLFOLDER]utility_bills_manager.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="SOFTWARE\AsanteDevs\UtilityBillsManager\Shortcuts"
                     Name="StartMenu"
                     Value="1"
                     Type="integer"
                     KeyPath="yes" />
    </Component>

    <!-- Desktop shortcut component -->
    <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="*">
      <Shortcut Id="DesktopShortcutEntry"
                Name="Utility Bills Manager"
                Description="Manage your utility bills"
                Target="[INSTALLFOLDER]utility_bills_manager.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU"
                     Key="SOFTWARE\AsanteDevs\UtilityBillsManager\Shortcuts"
                     Name="Desktop"
                     Value="1"
                     Type="integer"
                     KeyPath="yes" />
    </Component>

    <!--
      REMOVE_USERDATA property (default 0 = keep data).
      Set to 1 on the command line to also remove user data on uninstall:
        msiexec /x {product-guid} REMOVE_USERDATA=1
    -->
    <Property Id="REMOVE_USERDATA" Value="0" />

    <!--
      User-data directory — set from the environment during install so the
      RemoveFolderEx action can reference it at uninstall time.
      Path: %APPDATA%\AsanteDevs\Utility Bills Manager
    -->
    <Property Id="USERDATA_PATH">
      <RegistrySearch Id="SearchUserData"
                      Root="HKCU"
                      Key="SOFTWARE\AsanteDevs\UtilityBillsManager"
                      Name="DataPath"
                      Type="raw" />
    </Property>

    <!--
      Search for the install path written by a previous installation.
      Written to HKLM on every install/upgrade (see StoreDataPath below)
      so a reinstall can restore the same directory automatically.
    -->
    <Property Id="PREVIOUSINSTALLPATH">
      <RegistrySearch Id="SearchInstallPath"
                      Root="HKLM"
                      Key="SOFTWARE\AsanteDevs\UtilityBillsManager"
                      Name="InstallPath"
                      Type="raw" />
    </Property>

    <!--
      Pre-fill INSTALLFOLDER with the previously used path when found.
      Runs in both the UI sequence (directory shown in the feature-tree
      dialog is pre-filled) and the execute sequence (silent installs).
    -->
    <SetProperty Id="INSTALLFOLDER"
                 Value="[PREVIOUSINSTALLPATH]"
                 After="AppSearch"
                 Sequence="both"
                 Condition="PREVIOUSINSTALLPATH" />

    <!--
      Persist the data path to the registry on install so that uninstall
      can find it even if %APPDATA% resolves differently.
      Also persists the install path (HKLM) for future reinstall detection.
    -->
    <Component Id="StoreDataPath" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU"
                     Key="SOFTWARE\AsanteDevs\UtilityBillsManager"
                     Name="DataPath"
                     Value="[AppDataFolder]AsanteDevs\Utility Bills Manager"
                     Type="string"
                     KeyPath="yes" />
      <RegistryValue Root="HKLM"
                     Key="SOFTWARE\AsanteDevs\UtilityBillsManager"
                     Name="InstallPath"
                     Value="[INSTALLFOLDER]"
                     Type="string" />
      <!--
        RemoveFolderEx: removes the data directory recursively on uninstall,
        but ONLY when REMOVE_USERDATA=1 is passed to msiexec.
      -->
      <util:RemoveFolderEx Id="RemoveUserData"
                           On="uninstall"
                           Property="USERDATA_PATH"
                           Condition="REMOVE_USERDATA = 1" />
    </Component>

    <!--
      AppFiles ComponentGroup is generated at build time by:
        wix harvest dir <Release-path> -ag -cg AppFiles -dr INSTALLFOLDER -srd -o AppFiles.wxs
      The generated AppFiles.wxs is passed as a second input to wix build.
    -->

    <!--
      Level="1"  → selected by default  (INSTALLLEVEL default is 3)
      Level="4"  → NOT selected by default (mirrors the EXE: desktop is opt-in)
    -->
    <Feature Id="Complete" Title="Utility Bills Manager" Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="StoreDataPath" />
      <ComponentGroupRef Id="AppFiles" />

      <Feature Id="StartMenuShortcutFeature" Title="Start Menu shortcut"
               Description="Add a shortcut to the Windows Start Menu." Level="1">
        <ComponentRef Id="StartMenuShortcut" />
      </Feature>

      <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut"
               Description="Add a shortcut to the Windows Desktop." Level="4">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
    </Feature>

  </Package>
</Wix>
